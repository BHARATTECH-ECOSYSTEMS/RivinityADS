# LiteAds Backend Configuration

# Authentication and Tracking Secrets
LITEADS_AUTH__JWT_SECRET=your_jwt_secret_min_32_characters_here
LITEADS_TRACKING__SECRET=your_tracking_secret_min_32_characters_here

# Server and Reverse Proxy Configuration
# Public HTTPS URL for the web dashboard (required in production Compose)
LITEADS_SERVER__FRONTEND_URL=https://ads.example.com
# Comma-separated list of allowed CORS origins in production
LITEADS_SERVER__CORS_ORIGINS=https://ads.example.com
# Comma-separated list of trusted proxy IPs or CIDR blocks.
# In Docker Compose, the bridge network uses 172.16.0.0/12.
LITEADS_SERVER__TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# TLS Certificate Provisioning (Used by optional Certbot bootstrap/renewal profile)
TLS_DOMAIN=ads.example.com
CERTBOT_EMAIL=ops@example.com

# Monitoring (Required when enabling '--profile monitoring' in docker-compose.prod.yml)
GRAFANA_ADMIN_PASSWORD=your_strong_grafana_password_here
# Alertmanager runtime webhook endpoints (replace .invalid URLs in .env.prod on host; never commit secrets)
ALERTMANAGER_CRITICAL_WEBHOOK_URL=http://alertmanager-webhook.invalid/critical
ALERTMANAGER_WARNING_WEBHOOK_URL=http://alertmanager-webhook.invalid/warning
# Database Credentials
# Required in staging and production; must not use default or empty passwords
LITEADS_DATABASE__HOST=postgres
LITEADS_DATABASE__PORT=5432
LITEADS_DATABASE__NAME=liteads
LITEADS_DATABASE__USER=liteads
LITEADS_DATABASE__PASSWORD=your_strong_database_password_here
POSTGRES_USER=liteads
POSTGRES_PASSWORD=your_strong_database_password_here
POSTGRES_DB=liteads

# Redis Cache Configuration (Required non-empty in production Compose)
LITEADS_REDIS__HOST=redis
LITEADS_REDIS__PORT=6379
LITEADS_REDIS__PASSWORD=your_strong_redis_password_here

# Local Network Port Bindings
# Defaults to 127.0.0.1 loopback to prevent exposing database/cache/services to public interfaces
POSTGRES_PORT_BINDING=127.0.0.1:5432
REDIS_PORT_BINDING=127.0.0.1:6379
LITEADS_PORT_BINDING=127.0.0.1:8000
LITEADS_SERVER__HOST=localhost
LITEADS_SERVER__PORT=8000

# LLM Provider Configuration
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Email Delivery Configuration
LITEADS_EMAIL__HOST=mailpit
LITEADS_EMAIL__PORT=1025
LITEADS_EMAIL__USER=
LITEADS_EMAIL__PASSWORD=
LITEADS_EMAIL__FROM_ADDRESS=noreply@openadserver.local
LITEADS_EMAIL__USE_TLS=false
LITEADS_EMAIL__MOCK_DELIVERY=false

# Razorpay Payment Integration (Test Mode)
# Obtain test credentials from Razorpay Dashboard > Settings > API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# -----------------------------------------------------------------------------
# Laya Decision Engine (External Dependency)
# -----------------------------------------------------------------------------
# Laya is an optional external AI decision engine for campaign optimization.
# It is NOT bundled in Docker Compose.
# Keep LAYA_ENABLED=false (default) when running without Laya.
# When deploying Laya externally, set LAYA_ENABLED=true and provide its URL:
LAYA_ENABLED=false
LAYA_BASE_URL=http://localhost:8000
LAYA_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Campaign Optimization Loop (Phase 5)
# -----------------------------------------------------------------------------
# Supported modes:
# - suggestions_only: (Default, production recommended) Generates reviewable suggestions
#   in the advertiser dashboard. Zero automated mutations to budget, bids, targeting, or creatives.
# - shadow: Evaluates decisions and records audit entries without creating suggestions or applying actions.
# - limited_pilot: Bounded automated budget adjustments ONLY for campaigns listed in
#   LITEADS_OPTIMIZATION__PILOT_CAMPAIGN_IDS and opted-in via campaign.autopilot=true.
# - autopilot: Automated optimization for campaigns with campaign.autopilot=true.
LITEADS_OPTIMIZATION__MODE=suggestions_only
# Emergency kill switch: set to true to immediately freeze all optimization evaluations and actions
LITEADS_OPTIMIZATION__KILL_SWITCH=false
# Loop cycle interval in seconds (default: 900 = 15 minutes)
LITEADS_OPTIMIZATION__INTERVAL_SECONDS=900
# Cooldown between automatic optimizations on a single campaign (default: 3600 = 1 hour)
LITEADS_OPTIMIZATION__COOLDOWN_SECONDS=3600
# Rejection cooldown before re-suggesting an action rejected by an advertiser (default: 86400 = 24 hours)
LITEADS_OPTIMIZATION__REJECTION_COOLDOWN_SECONDS=86400
# Maximum automated changes per campaign in a rolling 24-hour period (default: 3)
LITEADS_OPTIMIZATION__MAX_DAILY_CHANGES_PER_CAMPAIGN=3
# Maximum single budget delta in currency units for limited_pilot mode (default: 500.0)
LITEADS_OPTIMIZATION__PILOT_MAX_BUDGET_DELTA_AMOUNT=500.0
# Pilot campaign IDs (comma-separated or JSON list) for limited_pilot mode (empty = fail closed to suggestions_only):
LITEADS_OPTIMIZATION__PILOT_CAMPAIGN_IDS=
# Deployment Topology:
# - Monolith Mode (default): Set LITEADS_ENABLE_OPTIMIZATION_WORKER=true to run the scheduler inside ad-server.
# - Dedicated Worker Mode: Set LITEADS_ENABLE_OPTIMIZATION_WORKER=false on ad-server when launching
#   dedicated worker containers with 'docker compose --profile worker up' to prevent dual schedulers.
LITEADS_ENABLE_OPTIMIZATION_WORKER=true

# -----------------------------------------------------------------------------
# Optional Listmonk Email Marketing (Phase 6.1A)
# Activated when running: docker compose --profile email-marketing up
# -----------------------------------------------------------------------------
LISTMONK_DB__USER=listmonk
LISTMONK_DB__PASSWORD=your_strong_listmonk_db_password_here
LISTMONK_DB__NAME=listmonk
LISTMONK_ADMIN__USERNAME=admin
LISTMONK_ADMIN__PASSWORD=your_strong_listmonk_admin_password_here
LISTMONK_PORT_BINDING=127.0.0.1:9000
LISTMONK_SMTP__HOST=mailpit
LISTMONK_SMTP__PORT=1025

# -----------------------------------------------------------------------------
# Optional Listmonk Transactional Email Provider (Phase 6.1B)
# Routes transactional emails through Listmonk POST /api/tx when enabled.
# Keep false (default) to deliver through standard SMTP / Mailpit.
# -----------------------------------------------------------------------------
LISTMONK_ENABLED=false
LISTMONK_URL=http://localhost:9000
LISTMONK_USER=admin
LISTMONK_TOKEN=your_listmonk_api_token_here
LISTMONK_REQUEST_TIMEOUT=10.0
LISTMONK_CONNECT_TIMEOUT=3.0

# Transactional Template IDs (numerical IDs created in Listmonk UI / API)
# Required when LISTMONK_ENABLED=true for the corresponding message flow:
LISTMONK_TEMPLATE_VERIFICATION_ID=1
LISTMONK_TEMPLATE_PASSWORD_RESET_ID=2
LISTMONK_TEMPLATE_SECURITY_NOTICE_ID=3
LISTMONK_TEMPLATE_DIGEST_ID=4
LISTMONK_TEMPLATE_GENERIC_ID=5

# -----------------------------------------------------------------------------
# Optional Listmonk Marketing Lists & Consent Settings (Phase 6.1C)
# Maps consent categories to configured Listmonk list IDs (numerical IDs)
# -----------------------------------------------------------------------------
LISTMONK_LIST_NEWSLETTER_ID=1
LISTMONK_LIST_ADVERTISER_EDUCATION_ID=2
LISTMONK_LIST_PUBLISHER_EDUCATION_ID=3
MARKETING_POLICY_VERSION=2026.1

# -----------------------------------------------------------------------------
# Optional Listmonk Email Marketing API Settings (Phase 6.1D)
# Controls feature access and guardrails for email marketing endpoints
# -----------------------------------------------------------------------------
# Keep false (default) to deny publishers access to email marketing (pilot guard)
LISTMONK_ALLOW_PUBLISHER_ACCESS=false
# Maximum number of rows allowed in a single CSV import payload (default: 1000)
LISTMONK_MAX_CSV_IMPORT_ROWS=1000
